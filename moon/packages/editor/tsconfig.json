{
  "extends": "@gitmono/tsconfig/base.json",
  "include": ["."],
  "exclude": ["node_modules", "dist", "eslint.config.mjs"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    // refractor@5 is exports-only ESM; classic "node" resolution cannot resolve it
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "sourceMap": true,
    "inlineSources": true,
    "sourceRoot": "/"
  }
}
